# Names only — never commit real values. The package does not read .env files;
# tools/serve_api.py loads ./.env (or I2H_ENV_FILE) into the environment for local runs.

# LLM: OpenAI-compatible provider
I2H_LLM_API_KEY=
# LLM: AWS Bedrock (access keys or a profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_PROFILE=

# Platform BE integration
# I2H_SERVICE_KEY  = BE POPPER_SERVICE_KEY  (required on inbound /runs requests)
# I2H_CALLBACK_KEY = BE POPPER_CALLBACK_KEY (sent on webhook deliveries; defaults to I2H_SERVICE_KEY)
I2H_SERVICE_KEY=
I2H_CALLBACK_KEY=

# Literature (optional)
S2_API_KEY=
